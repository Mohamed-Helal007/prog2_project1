<mxCell id="title" value="MARS-OPS | Emergency classes (Person 3)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="700" height="40" as="geometry"/></mxCell>
<mxCell id="etype" value="&lt;&lt;enumeration&gt;&gt;&lt;br&gt;&lt;b&gt;EmergencyType&lt;/b&gt;&lt;hr&gt;OXYGEN_LEAK&lt;br&gt;FIRE&lt;br&gt;ROVER_BREAKDOWN&lt;br&gt;MEDICAL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="280" height="150" as="geometry"/></mxCell>
<mxCell id="estate" value="&lt;&lt;enumeration&gt;&gt;&lt;br&gt;&lt;b&gt;EmergencyState&lt;/b&gt;&lt;hr&gt;PENDING&lt;br&gt;RESOLVED&lt;br&gt;UNRESOLVED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="280" height="135" as="geometry"/></mxCell>
<mxCell id="emergency" value="&lt;&lt;abstract&gt;&gt;&lt;br&gt;&lt;b&gt;Emergency&lt;/b&gt;&lt;hr&gt;- type : EmergencyType&lt;br&gt;- state : EmergencyState&lt;br&gt;- reason : String&lt;hr&gt;+ handle(colony : MarsColony) : OperationResult&lt;br&gt;# getRequiredCapabilities() : Set&lt;Capability&gt;&lt;br&gt;# getResponseCost() : Map&lt;ResourceType, Integer&gt;&lt;br&gt;# onDetected(colony) : void&lt;br&gt;# onResolved(colony) : void&lt;br&gt;# onUnresolved(colony) : void&lt;br&gt;+ getters for type, state, reason&lt;br&gt;Common flow: initial effect -&gt; find responders -&gt; check resources -&gt; dispatch -&gt; consume -&gt; resolve / mark unresolved -&gt; release responders" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="590" y="100" width="610" height="360" as="geometry"/></mxCell>
<mxCell id="ox" value="&lt;b&gt;OxygenLeak&lt;/b&gt;&lt;hr&gt;- habitat : Habitat&lt;br&gt;- leakAmount : int&lt;hr&gt;+ OxygenLeak(habitat, leakAmount)&lt;br&gt;# getRequiredCapabilities() : Set&lt;Capability&gt;&lt;br&gt;# getResponseCost() : Map&lt;ResourceType, Integer&gt;&lt;br&gt;# onDetected(...) : void&lt;br&gt;# onResolved(...) : void&lt;br&gt;# onUnresolved(...) : void&lt;br&gt;Requires repair-capable human + robot; reduces habitat oxygen on detection and again if unresolved" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="80" y="560" width="390" height="300" as="geometry"/></mxCell>
<mxCell id="fire" value="&lt;b&gt;Fire&lt;/b&gt;&lt;hr&gt;- laboratory : Laboratory&lt;hr&gt;+ Fire(laboratory)&lt;br&gt;# getRequiredCapabilities() : Set&lt;Capability&gt;&lt;br&gt;# getResponseCost() : Map&lt;ResourceType, Integer&gt;&lt;br&gt;# onDetected(...) : void&lt;br&gt;# onResolved(...) : void&lt;br&gt;# onUnresolved(...) : void&lt;br&gt;On detection: lab unavailable, equipment damaged, extra oxygen use; requests medical help for people inside" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="510" y="560" width="390" height="300" as="geometry"/></mxCell>
<mxCell id="rover" value="&lt;b&gt;RoverBreakdown&lt;/b&gt;&lt;hr&gt;- rover : Robot&lt;hr&gt;+ RoverBreakdown(rover)&lt;br&gt;# getRequiredCapabilities() : Set&lt;Capability&gt;&lt;br&gt;# getResponseCost() : Map&lt;ResourceType, Integer&gt;&lt;br&gt;# onDetected(...) : void&lt;br&gt;# onResolved(...) : void&lt;br&gt;# onUnresolved(...) : void&lt;br&gt;On detection: damages rover; rover stays in place and its running mission fails" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="940" y="560" width="390" height="300" as="geometry"/></mxCell>
<mxCell id="medical" value="&lt;b&gt;MedicalEmergency&lt;/b&gt;&lt;hr&gt;- patient : CrewMember&lt;br&gt;- facility : Facility&lt;hr&gt;+ MedicalEmergency(patient, facility)&lt;br&gt;# getRequiredCapabilities() : Set&lt;Capability&gt;&lt;br&gt;# getResponseCost() : Map&lt;ResourceType, Integer&gt;&lt;br&gt;# onDetected(...) : void&lt;br&gt;# onResolved(...) : void&lt;br&gt;# onUnresolved(...) : void&lt;br&gt;Checks medical officer, supplies and facility; on success treats patient" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="1370" y="560" width="390" height="300" as="geometry"/></mxCell>
<mxCell id="mars" value="&lt;b&gt;MarsColony&lt;/b&gt; (P1)&lt;hr&gt;Provides colony agents, facilities, resource pool and mission manager&lt;br&gt;+ getters used by emergency handling" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="1010" width="300" height="145" as="geometry"/></mxCell>
<mxCell id="opresult" value="&lt;b&gt;OperationResult&lt;/b&gt; (P1)&lt;hr&gt;- success : boolean&lt;br&gt;- reason : String&lt;hr&gt;+ ok() / fail(reason)&lt;br&gt;+ isSuccess() / getReason()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="420" y="1010" width="300" height="145" as="geometry"/></mxCell>
<mxCell id="agent" value="&lt;b&gt;Agent&lt;/b&gt; (P2 interface)&lt;hr&gt;+ canHandle(type) : boolean&lt;br&gt;+ isAvailable() : boolean&lt;br&gt;+ setAvailable(value) : void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="800" y="1010" width="300" height="135" as="geometry"/></mxCell>
<mxCell id="capability" value="&lt;b&gt;Capability&lt;/b&gt; (P2 enum)&lt;hr&gt;Emergency responder skills, e.g. REPAIR, FIRE_RESPONSE, MEDICAL&lt;br&gt;(use the team's agreed enum values)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="1160" y="1010" width="300" height="145" as="geometry"/></mxCell>
<mxCell id="resourcepool" value="&lt;b&gt;ResourcePool&lt;/b&gt; (P3 facilities)&lt;hr&gt;+ canSupply(cost) : boolean&lt;br&gt;+ consume(cost) : boolean" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="1220" width="300" height="115" as="geometry"/></mxCell>
<mxCell id="facility" value="&lt;b&gt;Facility / Habitat / Laboratory&lt;/b&gt; (P3 facilities)&lt;hr&gt;+ isOperational() : boolean&lt;br&gt;+ setStatus(status) : void&lt;br&gt;Habitat: loseOxygen(amount)&lt;br&gt;Laboratory: damageAllEquipment(), ignite()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="430" y="1220" width="350" height="115" as="geometry"/></mxCell>
