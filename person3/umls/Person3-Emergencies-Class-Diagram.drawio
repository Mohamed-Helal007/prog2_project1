<mxCell id="responseFlow" value="All emergencies use the common handle() flow: apply initial effect, identify responders, check and consume resources, resolve or mark unresolved, then release responders." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="800" y="900" width="790" height="70" as="geometry"/></mxCell>
